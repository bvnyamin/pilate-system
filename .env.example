# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL
POSTGRES_DB=aldra_pilates
POSTGRES_USER=aldra
POSTGRES_PASSWORD=replace-with-a-secure-password
DATABASE_URL=postgresql://aldra:replace-with-a-secure-password@db:5432/aldra_pilates
# Docker Compose configura también POSTGRES_HOST y POSTGRES_PORT internamente.

# Production security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Email de avisos. Desarrollo usa consola; en producción Resend Free funciona
# por SMTP. Configura DEFAULT_FROM_EMAIL con una dirección de dominio verificado.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Producción Resend: django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_replace_with_resend_api_key
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Aledra Pilates <avisos@your-verified-domain.cl>
NOTIFICATION_ADMIN_EMAILS=

# Google OAuth (opcional hasta registrar el cliente OAuth en Google Cloud).
# Callback local: http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_ALLOWED_EMAILS=
